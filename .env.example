# Copy to .env (git-ignored) and fill in. Never commit .env.
# Two MT5 terminal installs are required: one for the guard, one for the runner.
# MT5_*_PATH is the full path to that install's terminal64.exe.

# Process 1: guard (kill switch)
MT5_GUARD_LOGIN=
MT5_GUARD_PASSWORD=
MT5_GUARD_SERVER=FTMO-Demo
MT5_GUARD_PATH=C:\MT5-Guard\terminal64.exe

# Process 2: strategy runner
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=FTMO-Demo
# scripts\doctor.ps1 fills MT5_PATH, MT5_LOGIN, MT5_PASSWORD and MT5_SERVER in for you
MT5_PATH=

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dead-man's switch (e.g. healthchecks.io, 10-minute grace)
HEALTHCHECK_URL=
